# Full Google Sheet URL. The service account below must be an Editor.
GOOGLE_SHEET_URL="https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit"

# Minified JSON downloaded for a Google Cloud service account.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@....iam.gserviceaccount.com","client_id":"..."}'

# Use a random passcode of at least 16 characters.
APP_PASSCODE="replace-with-a-long-random-passcode"
